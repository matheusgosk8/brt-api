{
  "name": "brt-api",
  "version": "0.1.0",
  "private": true,
  "description": "Api para teste técnico da brasil terrenos",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/local/server.ts",
    "dev:once": "tsx src/local/server.ts",
    "build": "webpack --mode production",
    "build:dev": "webpack --mode development",
    "sam:invoke:health": "sam local invoke BrtApiFunction -e events/health.json --env-vars env.sam.json --docker-network btr_default",
    "sam:invoke:produtos": "sam local invoke BrtApiFunction -e events/produtos.json --env-vars env.sam.json --docker-network btr_default",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,js}\" --fix",
    "lint:check": "eslint \"src/**/*.{ts,js}\"",
    "format": "prettier --write \"src/**/*.{ts,js,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,js,json}\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "db:seed": "tsx src/scripts/seed.ts",
    "db:setup": "npm run db:generate && npm run db:migrate && npm run db:seed"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.1",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.44.6",
    "hono": "^4.7.5",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/aws-lambda": "^8.10.147",
    "@types/node": "^22.13.10",
    "@types/pg": "^8.15.5",
    "drizzle-kit": "^0.31.5",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.6.3",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^5.2.1",
    "globals": "^15.11.0",
    "prettier": "^3.3.3",
    "ts-loader": "^9.5.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.11.0",
    "webpack": "^5.98.0",
    "webpack-cli": "^6.0.1"
  }
}

